---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { href } from '@/lib/content';
---

<BaseLayout title="Search — bllog" description="Search the bllog archive.">
  <section class="shell search-page">
    <div class="search-header">
      <p class="section-kicker">Archive</p>
      <h1>Search</h1>
      <p>Find articles by title, description, category or tag.</p>

      <form class="search-box" id="search-form" action={href('/search/')} method="get">
        <span aria-hidden="true">⌕</span>
        <input
          id="search-input"
          name="q"
          type="search"
          autocomplete="off"
          placeholder="Search the archive…"
          aria-label="Search the archive"
        />
        <button class="button button-dark" type="submit">Search</button>
      </form>
    </div>

    <div class="search-results" id="search-results" aria-live="polite"></div>
  </section>

  <script define:vars={{ indexUrl: href('/search-index.json') }}>
    const input = document.querySelector('#search-input');
    const form = document.querySelector('#search-form');
    const results = document.querySelector('#search-results');

    const params = new URLSearchParams(window.location.search);
    input.value = params.get('q') ?? '';

    const escapeHtml = (value) => value.replace(/[&<>"']/g, (char) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    }[char]));

    const render = (items, query) => {
      if (!query) {
        results.innerHTML = '<div class="search-empty">Start typing to search the archive.</div>';
        return;
      }

      if (!items.length) {
        results.innerHTML = `<div class="search-empty">No stories found for “${escapeHtml(query)}”.</div>`;
        return;
      }

      results.innerHTML = `
        <div class="search-result-list">
          ${items.map((item) => `
            <a class="search-result" href="${item.url}">
              <div>
                <h2>${escapeHtml(item.title)}</h2>
                <p>${escapeHtml(item.description)}</p>
              </div>
              <div class="search-result-meta">${escapeHtml(item.category)} · ${escapeHtml(item.date)}</div>
            </a>
          `).join('')}
        </div>`;
    };

    let index = [];

    const search = (query) => {
      const needle = query.trim().toLowerCase();

      if (!needle) {
        render([], '');
        return;
      }

      const words = needle.split(/\s+/).filter(Boolean);

      const matches = index
        .map((item) => {
          const haystack = [
            item.title,
            item.description,
            item.category,
            ...item.tags,
          ].join(' ').toLowerCase();

          const score = words.reduce((total, word) => {
            if (item.title.toLowerCase().includes(word)) return total + 4;
            if (haystack.includes(word)) return total + 1;
            return total;
          }, 0);

          return { item, score };
        })
        .filter(({ score }) => score > 0)
        .sort((a, b) => b.score - a.score || a.item.dateValue - b.item.dateValue)
        .map(({ item }) => item);

      render(matches, query);
    };

    fetch(indexUrl)
      .then((response) => response.json())
      .then((data) => {
        index = data;
        search(input.value);
      })
      .catch(() => {
        results.innerHTML = '<div class="search-empty">Search index could not be loaded.</div>';
      });

    input.addEventListener('input', () => search(input.value));

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const query = input.value.trim();
      const url = new URL(form.action, window.location.origin);
      if (query) url.searchParams.set('q', query);
      window.history.replaceState({}, '', url);
      search(query);
      input.focus();
    });
  </script>
</BaseLayout>
